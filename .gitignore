# ---- 前端 ----
web/node_modules/
web/dist/

# ---- Go 构建产物 ----
/dist/
/bin/
*.exe
*.exe~
*.test
*.out

# go:embed all:dist 要求目录必须存在，所以保留一个占位文件，构建产物不入库
internal/web/dist/*
!internal/web/dist/.gitkeep

# ---- 运行期数据 ----
data/
testdata/data/
testdata/data2/
testdata/*.log
testdata/*.txt
testdata/frpfirewall
testdata/frpfirewall.exe
testdata/imp*.json
testdata/ports.txt

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# ---- 测试覆盖率 ----
coverage.out
coverage.html
*.coverprofile
*.prof

# ---- 前端杂项 ----
web/.vite/
web/*.tsbuildinfo
web/node_modules/.cache/

# ---- AI 助手本地状态（含内网拓扑/凭据线索，不入库） ----
.workbuddy/

# ---- 本地密钥（绝不入库） ----
.secrets/
*.pem
*.key
*.crt
!deploy/*.key.example

# ---- 救援：任何误落在根目录的临时文件 ----
/*.log
/*.tmp
/tmp/
